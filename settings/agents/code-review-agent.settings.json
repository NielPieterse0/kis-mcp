{
  "schema_version": 1,
  "enabled": true,
  "agent_id": "code-reviewer",
  "preferred_backend": "nvidia-nim",
  "fallback_backend": "codex-cli",
  "max_evidence_chars": 120000,
  "max_output_chars": 30000,
  "max_backend_attempts": 2,
  "review_deadline_seconds": 120,
  "nvidia": {
    "enabled": true,
    "base_url": "https://integrate.api.nvidia.com/v1",
    "api_key_env": "NVIDIA_API_KEY",
    "secret_ref": "secret://provider/nvidia-nim/api-key",
    "default_profile": "super",
    "timeout_seconds": 90,
    "benchmark": {
      "enabled": true,
      "timeout_seconds": 40,
      "latency_limit_seconds": 30,
      "max_tokens": 1024,
      "models": {
        "baseline-nano": "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning",
        "baseline-super": "nvidia/nemotron-3-super-120b-a12b",
        "baseline-ultra": "nvidia/nemotron-3-ultra-550b-a55b",
        "nano-text": "nvidia/nemotron-3-nano-30b-a3b",
        "laguna-xs": "poolside/laguna-xs-2.1",
        "deepseek-flash": "deepseek-ai/deepseek-v4-flash",
        "deepseek-pro": "deepseek-ai/deepseek-v4-pro",
        "glm-5.2": "z-ai/glm-5.2",
        "step-3.7-flash": "stepfun-ai/step-3.7-flash",
        "minimax-m3": "minimaxai/minimax-m3"
      }
    },
    "profiles": {
      "nano": {
        "model": "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning",
        "guidance": "Fast first-pass and focused iterative review for routine diffs, triage, and repeated review cycles.",
        "temperature": 0.6,
        "top_p": 0.95,
        "max_tokens": 65536,
        "reasoning_budget": 16384,
        "enable_thinking": true
      },
      "super": {
        "model": "nvidia/nemotron-3-super-120b-a12b",
        "guidance": "Default substantive review for multi-file changes, correctness, regressions, implementation plans, and broad repository context.",
        "temperature": 1.0,
        "top_p": 0.95,
        "max_tokens": 16384,
        "reasoning_budget": 16384,
        "enable_thinking": true
      },
      "ultra": {
        "model": "nvidia/nemotron-3-ultra-550b-a55b",
        "guidance": "Deepest review for architecture, subtle cross-component failures, complex state or concurrency, and high-impact safety or security analysis.",
        "temperature": 1.0,
        "top_p": 0.95,
        "max_tokens": 16384,
        "reasoning_budget": 16384,
        "enable_thinking": true
      }
    }
  },
  "codex": {
    "enabled": true,
    "script_path": "scripts/invoke-codex-agent.ps1",
    "executable": "C:\\Projects\\.kis-mcp\\tools\\codex\\0.147.0\\node_modules\\.bin\\codex.cmd",
    "home_path": "C:\\Projects\\.kis-mcp\\agent-hosts\\codex-reviewer",
    "expected_version": "0.147.0",
    "timeout_seconds": 180,
    "max_output_chars": 30000
  }
}
