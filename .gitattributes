# Canonical repository text format.
* text=auto eol=lf

# Explicit Windows command-script exceptions.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary artifacts.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tgz binary
*.exe binary
*.dll binary
*.docx binary
*.xlsx binary
