{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis-mcp.local/contracts/coordinator/worker-handoff.schema.json",
  "title": "Coordinator Worker Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "handoff_id",
    "execution_id",
    "attempt_id",
    "packet_id",
    "task_id",
    "assignment_generation",
    "reservation_id",
    "authority_revision",
    "fence_token",
    "worker_id",
    "runtime_binding",
    "result_id",
    "exact_head",
    "changed_paths",
    "evidence",
    "residual_state",
    "status",
    "observed_at",
    "run_id",
    "project_id",
    "change_id",
    "governed_worktree",
    "lifecycle_phase"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "contract": {
      "const": "coordinator-worker-handoff-v3"
    },
    "handoff_id": {
      "$ref": "#/$defs/nonEmpty"
    },
    "execution_id": {
      "$ref": "#/$defs/nonEmpty"
    },
    "attempt_id": {
      "$ref": "#/$defs/nonEmpty"
    },
    "packet_id": {
      "$ref": "#/$defs/nonEmpty"
    },
    "task_id": {
      "$ref": "#/$defs/nonEmpty"
    },
    "assignment_generation": {
      "type": "integer",
      "minimum": 1
    },
    "reservation_id": {
      "$ref": "#/$defs/nonEmpty"
    },
    "authority_revision": {
      "type": "integer",
      "minimum": 1
    },
    "fence_token": {
      "type": "integer",
      "minimum": 1
    },
    "worker_id": {
      "$ref": "#/$defs/nonEmpty"
    },
    "runtime_binding": {
      "$ref": "#/$defs/runtimeBindingReference"
    },
    "external_provenance": {
      "oneOf": [
        {"$ref": "#/$defs/githubProvenanceEvidence"},
        {"$ref": "#/$defs/legacyExternalProvenance"},
        {"type": "null"}
      ]
    },
    "result_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "exact_head": {
      "$ref": "#/$defs/gitIdentity"
    },
    "changed_paths": {
      "$ref": "#/$defs/strings"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "residual_state": {
      "$ref": "#/$defs/strings"
    },
    "status": {
      "enum": [
        "worker_done",
        "worker_failed",
        "worker_incomplete"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_id": {
      "$ref": "#/$defs/nonEmpty"
    },
    "project_id": {
      "$ref": "#/$defs/nonEmpty"
    },
    "change_id": {
      "$ref": "#/$defs/nonEmpty"
    },
    "governed_worktree": {
      "$ref": "#/$defs/nonEmpty"
    },
    "lifecycle_phase": {
      "$ref": "#/$defs/nonEmpty"
    }
  },
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmpty"
      }
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "githubProvenanceTuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "issue_number", "pull_number", "head_sha", "merge_sha"],
      "properties": {
        "provider": {"const": "github"},
        "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "issue_number": {"type": "integer", "minimum": 1},
        "pull_number": {"type": "integer", "minimum": 1},
        "head_sha": {"$ref": "#/$defs/sha"},
        "merge_sha": {
          "oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]
        }
      }
    },
    "githubProvenanceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "contract", "status", "tuple", "claim_sha256"],
      "properties": {
        "schema_version": {"const": 1},
        "contract": {"const": "github-provenance-evidence-v1"},
        "status": {"const": "verified"},
        "tuple": {"$ref": "#/$defs/githubProvenanceTuple"},
        "claim_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "legacyExternalProvenance": {
      "type": "object",
      "allOf": [
        {"not": {"required": ["provider"], "properties": {"provider": {"const": "github"}}}},
        {"not": {"required": ["contract"], "properties": {"contract": {"const": "github-provenance-evidence-v1"}}}}
      ]
    },
    "runtimeBindingReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "binding_fingerprint"
      ],
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "binding_fingerprint": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "gitIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_sha",
        "tree_sha"
      ],
      "properties": {
        "commit_sha": {
          "$ref": "#/$defs/sha"
        },
        "tree_sha": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference",
        "digest"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/nonEmpty"
        },
        "reference": {
          "$ref": "#/$defs/nonEmpty"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
