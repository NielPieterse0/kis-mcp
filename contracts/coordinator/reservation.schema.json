{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis-mcp.local/contracts/coordinator/reservation.schema.json",
  "title": "Coordinator Reservation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract", "reservation_id", "project_id", "change_id",
    "change_sequence", "base", "owned_paths", "shared_paths", "dependencies",
    "integration_owner", "authority_revision", "lease_id", "fence_token", "status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract": {"const": "coordinator-reservation-v1"},
    "reservation_id": {"$ref": "#/$defs/nonEmpty"},
    "project_id": {"$ref": "#/$defs/nonEmpty"},
    "change_id": {"$ref": "#/$defs/nonEmpty"},
    "change_sequence": {"type": "integer", "minimum": 1},
    "base": {"$ref": "#/$defs/gitIdentity"},
    "owned_paths": {"$ref": "#/$defs/uniqueStrings"},
    "shared_paths": {"$ref": "#/$defs/uniqueStrings"},
    "dependencies": {"$ref": "#/$defs/uniqueStrings"},
    "integration_owner": {"$ref": "#/$defs/nonEmpty"},
    "authority_revision": {"type": "integer", "minimum": 1},
    "lease_id": {"$ref": "#/$defs/nonEmpty"},
    "fence_token": {"type": "integer", "minimum": 1},
    "status": {"enum": ["reserved", "active", "released", "expired", "revoked"]}
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "uniqueStrings": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmpty"}
    },
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "gitIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "tree_sha"],
      "properties": {
        "commit_sha": {"$ref": "#/$defs/sha"},
        "tree_sha": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
