{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis-mcp.local/contracts/coordinator/lease.schema.json",
  "title": "Coordinator Lease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract", "lease_id", "reservation_id", "holder_id",
    "fence_token", "issued_at", "expires_at", "status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract": {"const": "coordinator-lease-v1"},
    "lease_id": {"$ref": "#/$defs/nonEmpty"},
    "reservation_id": {"$ref": "#/$defs/nonEmpty"},
    "holder_id": {"$ref": "#/$defs/nonEmpty"},
    "fence_token": {"type": "integer", "minimum": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["active", "expired", "released", "revoked", "reassigned"]}
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1}
  }
}
