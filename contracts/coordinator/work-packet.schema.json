{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis-mcp.local/contracts/coordinator/work-packet.schema.json",
  "title": "Coordinator Work Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "packet_id",
    "work_id",
    "project_id",
    "change_id",
    "slice_id",
    "task_id",
    "outcome",
    "required_capabilities",
    "scope",
    "dependencies",
    "acceptance_checks",
    "exact_base",
    "authority",
    "runtime_binding",
    "verification_requirement_ids",
    "required_handoff_fields",
    "assignment",
    "issued_at",
    "run_id",
    "predecessor_run_id",
    "governed",
    "lifecycle_phase",
    "authority_references",
    "work_management",
    "external_provenance",
    "executor"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "contract": {
      "const": "coordinator-work-packet-v3"
    },
    "packet_id": {
      "$ref": "#/$defs/nonEmpty"
    },
    "work_id": {
      "$ref": "#/$defs/nonEmpty"
    },
    "project_id": {
      "$ref": "#/$defs/nonEmpty"
    },
    "change_id": {
      "$ref": "#/$defs/nonEmpty"
    },
    "slice_id": {
      "$ref": "#/$defs/nonEmpty"
    },
    "task_id": {
      "$ref": "#/$defs/nonEmpty"
    },
    "outcome": {
      "$ref": "#/$defs/nonEmpty"
    },
    "required_capabilities": {
      "$ref": "#/$defs/strings"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "dependencies": {
      "$ref": "#/$defs/strings"
    },
    "acceptance_checks": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "exact_base": {
      "$ref": "#/$defs/gitIdentity"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "runtime_binding": {
      "$ref": "#/$defs/runtimeBindingReference"
    },
    "verification_requirement_ids": {
      "$ref": "#/$defs/strings"
    },
    "required_handoff_fields": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "assignment": {
      "$ref": "#/$defs/assignment"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_id": {
      "$ref": "#/$defs/nonEmpty"
    },
    "predecessor_run_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "governed": {
      "$ref": "#/$defs/governed"
    },
    "lifecycle_phase": {
      "$ref": "#/$defs/nonEmpty"
    },
    "authority_references": {
      "$ref": "#/$defs/strings"
    },
    "work_management": {
      "type": [
        "object",
        "null"
      ]
    },
    "external_provenance": {
      "oneOf": [
        {"$ref": "#/$defs/githubProvenanceEvidence"},
        {"$ref": "#/$defs/legacyExternalProvenance"},
        {"type": "null"}
      ]
    },
    "executor": {
      "$ref": "#/$defs/executor"
    }
  },
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmpty"
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmpty"
      }
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "githubProvenanceTuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "issue_number", "pull_number", "head_sha", "merge_sha"],
      "properties": {
        "provider": {"const": "github"},
        "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "issue_number": {"type": "integer", "minimum": 1},
        "pull_number": {"type": "integer", "minimum": 1},
        "head_sha": {"$ref": "#/$defs/sha"},
        "merge_sha": {
          "oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]
        }
      }
    },
    "githubProvenanceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "contract", "status", "tuple", "claim_sha256"],
      "properties": {
        "schema_version": {"const": 1},
        "contract": {"const": "github-provenance-evidence-v1"},
        "status": {"const": "verified"},
        "tuple": {"$ref": "#/$defs/githubProvenanceTuple"},
        "claim_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "legacyExternalProvenance": {
      "type": "object",
      "allOf": [
        {"not": {"required": ["provider"], "properties": {"provider": {"const": "github"}}}},
        {"not": {"required": ["contract"], "properties": {"contract": {"const": "github-provenance-evidence-v1"}}}}
      ]
    },
    "gitIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_sha",
        "tree_sha"
      ],
      "properties": {
        "commit_sha": {
          "$ref": "#/$defs/sha"
        },
        "tree_sha": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owned_paths",
        "shared_paths",
        "integration_owner"
      ],
      "properties": {
        "owned_paths": {
          "$ref": "#/$defs/strings"
        },
        "shared_paths": {
          "$ref": "#/$defs/strings"
        },
        "integration_owner": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reservation_id",
        "authority_revision",
        "lease_id",
        "fence_token"
      ],
      "properties": {
        "reservation_id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "authority_revision": {
          "type": "integer",
          "minimum": 1
        },
        "lease_id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "fence_token": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "runtimeBindingReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "binding_fingerprint"
      ],
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "binding_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "key"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "key": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "governed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "worktree",
        "base_revision"
      ],
      "properties": {
        "root": {
          "$ref": "#/$defs/nonEmpty"
        },
        "worktree": {
          "$ref": "#/$defs/nonEmpty"
        },
        "base_revision": {
          "$ref": "#/$defs/gitIdentity"
        }
      }
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_id",
        "profile",
        "runtime_id"
      ],
      "properties": {
        "worker_id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "profile": {
          "$ref": "#/$defs/nonEmpty"
        },
        "runtime_id": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    }
  }
}
