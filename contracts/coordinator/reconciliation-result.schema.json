{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis-mcp.local/contracts/coordinator/reconciliation-result.schema.json",
  "title": "Coordinator Reconciliation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract", "reconciliation_id", "handoff_id",
    "reservation_id", "authority_revision", "fence_token", "runtime_binding",
    "validations", "status", "violations", "verification_requirement_ids", "integration"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract": {"const": "coordinator-reconciliation-result-v1"},
    "reconciliation_id": {"$ref": "#/$defs/nonEmpty"},
    "handoff_id": {"$ref": "#/$defs/nonEmpty"},
    "reservation_id": {"$ref": "#/$defs/nonEmpty"},
    "authority_revision": {"type": "integer", "minimum": 1},
    "fence_token": {"type": "integer", "minimum": 1},
    "runtime_binding": {"$ref": "#/$defs/runtimeBindingReference"},
    "validations": {"$ref": "#/$defs/validations"},
    "status": {"enum": ["accepted", "rejected", "incomplete"]},
    "violations": {"type": "array", "items": {"$ref": "#/$defs/violation"}},
    "verification_requirement_ids": {"$ref": "#/$defs/strings"},
    "integration": {"$ref": "#/$defs/integration"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "rejected"}}},
      "then": {
        "properties": {
          "violations": {"minItems": 1},
          "integration": {"properties": {"queue_state": {"const": "blocked"}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "accepted"}}},
      "then": {
        "properties": {
          "violations": {"maxItems": 0},
          "validations": {"$ref": "#/$defs/passedValidations"},
          "verification_requirement_ids": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "incomplete"}}},
      "then": {
        "properties": {
          "integration": {
            "properties": {"queue_state": {"enum": ["not_queued", "blocked"]}}
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "strings": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmpty"}
    },
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtimeBindingReference": {
      "type": "object", "additionalProperties": false,
      "required": ["binding_id", "binding_fingerprint"],
      "properties": {
        "binding_id": {"$ref": "#/$defs/nonEmpty"},
        "binding_fingerprint": {"$ref": "#/$defs/digest"}
      }
    },
    "validations": {
      "type": "object", "additionalProperties": false,
      "required": [
        "reservation", "runtime_binding", "fence", "global_claims", "local_scope", "exact_head"
      ],
      "properties": {
        "reservation": {"$ref": "#/$defs/validation"},
        "runtime_binding": {"$ref": "#/$defs/validation"},
        "fence": {"$ref": "#/$defs/validation"},
        "global_claims": {"$ref": "#/$defs/validation"},
        "local_scope": {"$ref": "#/$defs/validation"},
        "exact_head": {"$ref": "#/$defs/validation"}
      }
    },
    "validation": {"enum": ["passed", "failed", "incomplete"]},
    "passedValidations": {
      "type": "object", "additionalProperties": false,
      "required": [
        "reservation", "runtime_binding", "fence", "global_claims", "local_scope", "exact_head"
      ],
      "properties": {
        "reservation": {"const": "passed"},
        "runtime_binding": {"const": "passed"},
        "fence": {"const": "passed"},
        "global_claims": {"const": "passed"},
        "local_scope": {"const": "passed"},
        "exact_head": {"const": "passed"}
      }
    },
    "violation": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "reason"],
      "properties": {
        "code": {"$ref": "#/$defs/nonEmpty"},
        "reason": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "integration": {
      "type": "object", "additionalProperties": false,
      "required": ["owner_change_id", "queue_state", "merge_authority_granted"],
      "properties": {
        "owner_change_id": {"$ref": "#/$defs/nonEmpty"},
        "queue_state": {"enum": ["not_queued", "queued", "blocked"]},
        "merge_authority_granted": {"const": false}
      }
    }
  }
}
