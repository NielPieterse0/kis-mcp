{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis-mcp.local/contracts/tools/mcp-sdk-integrations/fetch.schema.json",
  "title": "Fetch MCP Tool Settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "enabled",
    "source_repository",
    "source_revision",
    "package_name",
    "package_version",
    "executable",
    "arguments",
    "environment_names"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "enabled": {"type": "boolean"},
    "source_repository": {"const": "https://github.com/modelcontextprotocol/servers"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "package_name": {"const": "mcp-server-fetch"},
    "package_version": {"const": "0.6.3"},
    "executable": {"type": "string", "minLength": 1},
    "arguments": {
      "type": "array",
      "prefixItems": [{"const": "-m"}, {"const": "mcp_server_fetch"}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "environment_names": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$"},
      "uniqueItems": true
    }
  }
}
