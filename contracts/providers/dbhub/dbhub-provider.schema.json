{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis-mcp.local/contracts/providers/dbhub/dbhub-provider.schema.json",
  "title": "KIS DBHub Provider Settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider_id", "authoritative_source", "release_tag", "source_revision", "transport", "node_executable", "entry_point", "runtime_root", "max_rows", "enabled_tools"],
  "properties": {
    "schema_version": {"const": 1},
    "provider_id": {"const": "dbhub"},
    "authoritative_source": {"const": "https://github.com/bytebase/dbhub"},
    "release_tag": {"const": "v1.2.0"},
    "source_revision": {"const": "1bed0b8bd8e6e3e625c83f571d12f748f2d7a0b0"},
    "transport": {"const": "stdio"},
    "node_executable": {"type": "string", "minLength": 1},
    "entry_point": {"type": "string", "pattern": "^C:\\\\Projects\\\\"},
    "runtime_root": {"type": "string", "pattern": "^C:\\\\Projects\\\\"},
    "max_rows": {"type": "integer", "minimum": 1, "maximum": 10000},
    "enabled_tools": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["search_objects", "execute_sql"]}
    }
  }
}
