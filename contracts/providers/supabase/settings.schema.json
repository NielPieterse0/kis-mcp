{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis-mcp.local/contracts/providers/supabase/settings.schema.json",
  "title": "kis-mcp Supabase MCP provider settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "source",
    "upstream",
    "authentication",
    "downstream"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "server_name"],
      "properties": {
        "id": {"const": "supabase"},
        "server_name": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_url", "repository", "revision"],
      "properties": {
        "registry_url": {"const": "https://github.com/mcp/com.supabase/mcp"},
        "repository": {"const": "https://github.com/supabase/mcp"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport",
        "base_url",
        "read_only",
        "features",
        "verify_tls"
      ],
      "properties": {
        "transport": {"const": "streamable-http"},
        "base_url": {"const": "https://mcp.supabase.com/mcp"},
        "read_only": {"type": "boolean"},
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        },
        "verify_tls": {"const": true}
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "client_name",
        "token_storage",
        "keyring_service",
        "legacy_pat_env",
        "callback_host",
        "callback_timeout_seconds"
      ],
      "properties": {
        "mode": {"const": "oauth-dcr"},
        "client_name": {"type": "string", "minLength": 1},
        "token_storage": {"const": "windows-keyring"},
        "keyring_service": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        "legacy_pat_env": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "callback_host": {"const": "localhost"},
        "callback_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "downstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport"],
      "properties": {
        "transport": {"const": "stdio"}
      }
    }
  }
}
