{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis-mcp.local/contracts/providers/github/provider-settings.schema.json",
  "title": "kis-mcp GitHub MCP Provider Settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "authoritative_source",
    "source_revision",
    "transport",
    "executable",
    "token_env",
    "toolsets",
    "approved_repositories",
    "unscoped_tools"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "provider_id": {"const": "github-mcp"},
    "authoritative_source": {"const": "https://github.com/github/github-mcp-server"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "transport": {"const": "stdio"},
    "executable": {"type": "string", "minLength": 1},
    "token_env": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$"},
    "toolsets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}
    },
    "approved_repositories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?$"}
    },
    "unscoped_tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}
    }
  }
}
