{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis-mcp.local/contracts/providers/runtime/platform-runtime.schema.json",
  "title": "kis-mcp Provider Runtime Composition Settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "providers"],
  "properties": {
    "schema_version": {"const": 1},
    "providers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider_id", "enabled", "namespace"],
        "properties": {
          "provider_id": {
            "type": "string",
            "enum": ["control-center", "github-mcp", "supabase"]
          },
          "enabled": {"type": "boolean"},
          "namespace": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*$"
          }
        },
        "allOf": [
          {
            "if": {"properties": {"provider_id": {"const": "control-center"}}, "required": ["provider_id"]},
            "then": {"properties": {"namespace": {"const": "controlcenter"}}}
          },
          {
            "if": {"properties": {"provider_id": {"const": "github-mcp"}}, "required": ["provider_id"]},
            "then": {"properties": {"namespace": {"const": "github"}}}
          },
          {
            "if": {"properties": {"provider_id": {"const": "supabase"}}, "required": ["provider_id"]},
            "then": {"properties": {"namespace": {"const": "supabase"}}}
          }
        ]
      },
      "allOf": [
        {"contains": {"properties": {"provider_id": {"const": "github-mcp"}}, "required": ["provider_id"]}},
        {"contains": {"properties": {"provider_id": {"const": "supabase"}}, "required": ["provider_id"]}}
      ]
    }
  }
}
