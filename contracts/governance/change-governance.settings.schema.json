{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis-mcp.local/contracts/governance/change-governance.settings.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "complexities", "review_types", "risk_triggers"],
  "properties": {
    "schema_version": {"const": 1},
    "complexities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/complexity"}
    },
    "review_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmpty"}
    },
    "risk_triggers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/risk"}
    }
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmpty"}
    },
    "complexity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "max_verifications", "base_reviews", "artifacts"],
      "properties": {
        "description": {"$ref": "#/$defs/nonEmpty"},
        "max_verifications": {"type": "integer", "minimum": 1, "maximum": 20},
        "base_reviews": {"$ref": "#/$defs/stringList"},
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": {"const": "scope.json"},
          "items": {"$ref": "#/$defs/nonEmpty"}
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "reviews"],
      "properties": {
        "description": {"$ref": "#/$defs/nonEmpty"},
        "reviews": {"$ref": "#/$defs/stringList"}
      }
    }
  }
}
