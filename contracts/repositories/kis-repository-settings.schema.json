{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis-mcp.local/contracts/repositories/kis-repository-settings.schema.json",
  "title": "kis-mcp Repository Settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_id",
    "github_repository",
    "gh_projects"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repository_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "github_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?$"
    },
    "gh_projects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binding_id",
          "owner",
          "owner_type",
          "project_number"
        ],
        "properties": {
          "binding_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "owner": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "owner_type": {
            "enum": [
              "user",
              "org"
            ]
          },
          "project_number": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
