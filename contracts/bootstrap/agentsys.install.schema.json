{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis-mcp.local/contracts/bootstrap/agentsys.install.schema.json",
  "title": "AgentSys Bootstrap Settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "tool_id", "package", "version", "install_root",
    "managed_home", "npm_cache_root", "temp_root", "quarantine_root",
    "hosts", "opencode_strip_models", "kis_mcp_command_policy"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "tool_id": {"const": "agentsys"},
    "package": {"const": "agentsys"},
    "version": {"const": "6.0.1"},
    "install_root": {"const": "C:\\Projects\\.kis-mcp\\tools\\agentsys\\6.0.1"},
    "managed_home": {"const": "C:\\Projects\\.kis-mcp\\agent-hosts\\agentsys"},
    "npm_cache_root": {"type": "string", "pattern": "^C:\\\\Projects\\\\"},
    "temp_root": {"type": "string", "pattern": "^C:\\\\Projects\\\\"},
    "quarantine_root": {"type": "string", "pattern": "^C:\\\\Projects\\\\"},
    "hosts": {"const": ["claude", "opencode", "codex"]},
    "opencode_strip_models": {"type": "boolean"},
    "kis_mcp_command_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_enabled", "available_commands", "enabled_commands"],
      "properties": {
        "default_enabled": {"const": false},
        "available_commands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        },
        "enabled_commands": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        }
      }
    }
  }
}
