{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis-mcp.local/contracts/control-center/settings.schema.json",
  "title": "KIS Control Center Settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_path",
    "runtime_settings_path",
    "policy_path",
    "provider_settings_path",
    "quarantine_root",
    "verification_command",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_path": {
      "type": "string",
      "minLength": 1
    },
    "runtime_settings_path": {
      "type": "string",
      "minLength": 1
    },
    "policy_path": {
      "type": "string",
      "minLength": 1
    },
    "provider_settings_path": {
      "type": "string",
      "minLength": 1
    },
    "quarantine_root": {
      "type": "string",
      "minLength": 1
    },
    "verification_command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_provider_entries",
        "max_quarantine_records",
        "git_timeout_seconds",
        "max_json_bytes"
      ],
      "properties": {
        "max_provider_entries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_quarantine_records": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "git_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "max_json_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 10000000
        }
      }
    }
  }
}
