{
  "adapter_contract": {
    "command_tools": [
      "execute_command",
      "interact_with_process",
      "start_process"
    ],
    "conditional_write_path_keys": {
      "write_pdf": [
        "outputPath",
        "path"
      ]
    },
    "configuration_tool": {
      "name": "set_config_value",
      "unexposed_keys": [
        "allowedDirectories",
        "blockedCommands"
      ]
    },
    "delete_path_keys": {
      "delete_directory": [
        "path"
      ],
      "delete_file": [
        "path"
      ],
      "remove_directory": [
        "path"
      ],
      "remove_file": [
        "path"
      ]
    },
    "entry_path_keys": {
      "move_file": [
        "destination",
        "source"
      ]
    },
    "network_only_tools": [
      "give_feedback_to_desktop_commander"
    ],
    "unexposed_tool_arguments": {
      "read_file": [
        "isUrl"
      ]
    },
    "write_path_keys": {
      "create_directory": [
        "path"
      ],
      "edit_block": [
        "file_path",
        "path"
      ],
      "write_docx": [
        "path"
      ],
      "write_excel": [
        "path"
      ],
      "write_file": [
        "path"
      ]
    }
  },
  "effect_classifications": {
    "create_directory": "direct_write",
    "edit_block": "direct_write",
    "force_terminate": "no_proven_prohibited_effect",
    "get_config": "no_proven_prohibited_effect",
    "get_file_info": "no_proven_prohibited_effect",
    "get_more_search_results": "no_proven_prohibited_effect",
    "get_prompts": "no_proven_prohibited_effect",
    "get_recent_tool_calls": "no_proven_prohibited_effect",
    "get_usage_stats": "no_proven_prohibited_effect",
    "give_feedback_to_desktop_commander": "network_only",
    "interact_with_process": "command_execution",
    "kill_process": "no_proven_prohibited_effect",
    "list_directory": "no_proven_prohibited_effect",
    "list_processes": "no_proven_prohibited_effect",
    "list_searches": "no_proven_prohibited_effect",
    "list_sessions": "no_proven_prohibited_effect",
    "move_file": "entry_mutation",
    "read_file": "mixed_network_argument",
    "read_multiple_files": "no_proven_prohibited_effect",
    "read_process_output": "no_proven_prohibited_effect",
    "set_config_value": "provider_configuration",
    "start_process": "command_execution",
    "start_search": "no_proven_prohibited_effect",
    "stop_search": "no_proven_prohibited_effect",
    "write_file": "direct_write",
    "write_pdf": "conditional_write"
  },
  "provider": {
    "package": "@wonderwhy-er/desktop-commander",
    "version": "0.2.46"
  },
  "schema_version": 1,
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false,
        "title": "Create Directory"
      },
      "input_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "name": "create_directory"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "openWorldHint": false,
        "readOnlyHint": false,
        "title": "Edit Block"
      },
      "input_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "content": {},
          "expected_replacements": {
            "default": 1,
            "type": "number"
          },
          "file_path": {
            "type": "string"
          },
          "new_string": {
            "type": "string"
          },
          "old_string": {
            "type": "string"
          },
          "options": {
            "additionalProperties": {},
            "type": "object"
          },
          "origin": {
            "enum": [
              "ui",
              "llm"
            ],
            "type": "string"
          },
          "range": {
            "type": "string"
          }
        },
        "required": [
          "file_path"
        ],
        "type": "object"
      },
      "name": "edit_block"
    },
    {
      "annotations": {
