{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kis-mcp://contracts/secrets/vault-metadata.schema.json",
  "title": "kis-mcp secret vault metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generation", "created_at", "updated_at", "references"],
  "properties": {
    "schema_version": { "const": 1 },
    "generation": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "updated_at"],
        "properties": {
          "reference": { "type": "string", "pattern": "^secret://[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)+$" },
          "updated_at": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
