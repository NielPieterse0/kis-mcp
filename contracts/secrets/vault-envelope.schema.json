{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kis-mcp://contracts/secrets/vault-envelope.schema.json",
  "title": "kis-mcp encrypted secret vault envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cipher",
    "kdf",
    "kdf_parameters",
    "salt",
    "nonce",
    "ciphertext"
  ],
  "properties": {
    "version": { "const": 1 },
    "cipher": { "const": "AES-256-GCM" },
    "kdf": { "const": "argon2id" },
    "kdf_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iterations", "memory_cost_kib", "lanes", "length"],
      "properties": {
        "iterations": { "type": "integer", "minimum": 1, "maximum": 10 },
        "memory_cost_kib": { "type": "integer", "minimum": 8192, "maximum": 1048576 },
        "lanes": { "type": "integer", "minimum": 1, "maximum": 16 },
        "length": { "const": 32 }
      }
    },
    "salt": { "type": "string", "minLength": 1 },
    "nonce": { "type": "string", "minLength": 1 },
    "ciphertext": { "type": "string", "minLength": 1 }
  }
}
