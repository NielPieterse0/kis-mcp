{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis-mcp.local/contracts/execution/request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "request_id", "project_id", "verification_profile_id", "source", "profile", "executable", "arguments", "timeout_ms", "evidence_limit_chars"],
  "properties": {
    "schema_version": {"const": 1},
    "contract": {"const": "execution-request-v1"},
    "request_id": {"$ref": "#/$defs/logicalId"},
    "project_id": {"$ref": "#/$defs/logicalId"},
    "verification_profile_id": {"$ref": "#/$defs/logicalId"},
    "source": {"$ref": "#/$defs/source"},
    "profile": {"$ref": "#/$defs/profile"},
    "executable": {"type": "string", "minLength": 1},
    "arguments": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 3600000},
    "evidence_limit_chars": {"type": "integer", "minimum": 1, "maximum": 500000}
  },
  "$defs": {
    "logicalId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["project_path", "revision", "exact"], "properties": {"project_path": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}, "exact": {"type": "boolean"}}},
    "profile": {"type": "object", "additionalProperties": false, "required": ["profile_id", "backend_id", "image_id", "toolchain_id"], "properties": {"profile_id": {"$ref": "#/$defs/logicalId"}, "backend_id": {"$ref": "#/$defs/logicalId"}, "image_id": {"$ref": "#/$defs/logicalId"}, "toolchain_id": {"$ref": "#/$defs/logicalId"}}}
  }
}
