{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis-mcp.local/contracts/execution/result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "request_id", "backend_id", "status", "exit_code", "duration_ms", "source_revision", "image_id", "toolchain_id", "cleanup", "failure_classification", "lifecycle", "evidence"],
  "properties": {
    "schema_version": {"const": 1}, "contract": {"const": "execution-result-v1"},
    "request_id": {"$ref": "#/$defs/logicalId"}, "backend_id": {"$ref": "#/$defs/logicalId"},
    "status": {"enum": ["passed", "failed", "incomplete"]}, "exit_code": {"type": ["integer", "null"]},
    "duration_ms": {"type": "integer", "minimum": 0}, "source_revision": {"type": "string", "minLength": 1},
    "image_id": {"$ref": "#/$defs/logicalId"}, "toolchain_id": {"$ref": "#/$defs/logicalId"},
    "cleanup": {"enum": ["not-required", "destroyed", "quarantined", "failed"]},
    "failure_classification": {"enum": ["none", "execution_failed", "timeout_or_incomplete", "backend_unavailable", "source_identity_required", "source_mismatch", "lifecycle_failed", "cleanup_failed", "profile_identity_mismatch"]},
    "lifecycle": {"type": "array", "items": {"enum": ["requested", "readiness", "materializing", "provisioning", "starting", "transferring", "executing", "capturing", "cleaning", "completed", "quarantined", "incomplete"]}},
    "evidence": {"$ref": "#/$defs/evidence"}
  },
  "$defs": {
    "logicalId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["stdout", "stderr", "diagnostics", "truncated", "receipt_path", "receipt_sha256", "source_tree", "source_fingerprint", "evidence_reference", "transferred_bytes"], "properties": {"stdout": {"type": "string"}, "stderr": {"type": "string"}, "diagnostics": {"type": "array", "items": {"type": "string"}}, "truncated": {"type": "boolean"}, "receipt_path": {"type": ["string", "null"]}, "receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "source_tree": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}, "source_fingerprint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "evidence_reference": {"type": ["string", "null"]}, "transferred_bytes": {"type": ["integer", "null"], "minimum": 0}}}
  }
}
