{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis-mcp.local/contracts/execution/settings.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "default_profile", "evidence_limit_chars", "profiles"],
  "properties": {
    "schema_version": {"const": 1}, "default_profile": {"$ref": "#/$defs/logicalId"},
    "evidence_limit_chars": {"type": "integer", "minimum": 1, "maximum": 500000},
    "profiles": {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "#/$defs/local"}, {"$ref": "#/$defs/hyperv"}, {"$ref": "#/$defs/virtualbox"}]}}
  },
  "$defs": {
    "logicalId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "baseProperties": {"type": "object"},
    "local": {"type": "object", "additionalProperties": false, "required": ["profile_id", "backend_id", "enabled", "image_id", "toolchain_id"], "properties": {"profile_id": {"$ref": "#/$defs/logicalId"}, "backend_id": {"const": "local-process"}, "enabled": {"type": "boolean"}, "image_id": {"$ref": "#/$defs/logicalId"}, "toolchain_id": {"$ref": "#/$defs/logicalId"}, "local": {"$ref": "#/$defs/localConfig"}}},
    "localConfig": {"type": "object", "additionalProperties": false, "required": ["state_root", "materialize_timeout_ms", "worker_cleanup_grace_ms"], "properties": {"state_root": {"type": "string", "pattern": "^C:\\\\Projects\\\\\\.kis-mcp(?:\\\\|$)"}, "materialize_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 600000}, "worker_cleanup_grace_ms": {"type": "integer", "minimum": 1, "maximum": 120000}}},
    "hyperv": {"type": "object", "additionalProperties": false, "required": ["profile_id", "backend_id", "enabled", "image_id", "toolchain_id", "hyperv"], "properties": {"profile_id": {"$ref": "#/$defs/logicalId"}, "backend_id": {"const": "windows-hyperv"}, "enabled": {"type": "boolean"}, "image_id": {"$ref": "#/$defs/logicalId"}, "toolchain_id": {"$ref": "#/$defs/logicalId"}, "hyperv": {"$ref": "#/$defs/hypervConfig"}}},
    "hypervConfig": {"type": "object", "additionalProperties": false, "required": ["template_vm", "checkpoint_name", "state_root", "guest_workspace", "guest_username_env", "guest_password_env", "startup_timeout_ms", "cleanup_timeout_ms"], "properties": {"template_vm": {"type": "string", "minLength": 1}, "checkpoint_name": {"type": "string", "minLength": 1}, "state_root": {"type": "string", "pattern": "^C:\\\\Projects\\\\\\.kis-mcp(?:\\\\|$)"}, "guest_workspace": {"type": "string", "minLength": 3}, "guest_username_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"}, "guest_password_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"}, "startup_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 600000}, "cleanup_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 600000}}},
    "virtualbox": {"type": "object", "additionalProperties": false, "required": ["profile_id", "backend_id", "enabled", "image_id", "toolchain_id", "virtualbox"], "properties": {"profile_id": {"$ref": "#/$defs/logicalId"}, "backend_id": {"const": "windows-virtualbox"}, "enabled": {"type": "boolean"}, "image_id": {"$ref": "#/$defs/logicalId"}, "toolchain_id": {"$ref": "#/$defs/logicalId"}, "virtualbox": {"$ref": "#/$defs/virtualboxConfig"}}},
    "virtualboxConfig": {"type": "object", "additionalProperties": false, "required": ["vboxmanage_path", "template_vm", "snapshot_name", "state_root", "vbox_user_home", "guest_workspace", "guest_username_env", "guest_password_file_env", "startup_timeout_ms", "cleanup_timeout_ms"], "properties": {"vboxmanage_path": {"type": "string", "minLength": 3}, "template_vm": {"type": "string", "minLength": 1}, "snapshot_name": {"type": "string", "minLength": 1}, "state_root": {"type": "string", "pattern": "^C:\\\\Projects\\\\\\.kis-mcp(?:\\\\|$)"}, "vbox_user_home": {"type": "string", "pattern": "^C:\\\\Projects\\\\\\.kis-mcp(?:\\\\|$)"}, "guest_workspace": {"type": "string", "minLength": 3}, "guest_username_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"}, "guest_password_file_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"}, "startup_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 600000}, "cleanup_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 600000}}}
  }
}
