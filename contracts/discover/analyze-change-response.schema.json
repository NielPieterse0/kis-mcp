{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis-mcp.local/contracts/discover/analyze-change-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "normalized_change", "change", "impact", "replacement_candidates", "reconciliation"],
  "properties": {
    "schema_version": {"const": 1},
    "tool": {"const": "analyze_change"},
    "normalized_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "changed_paths", "supplied_changes", "github_context"],
      "properties": {
        "source": {"enum": ["working_tree", "staged", "commit", "range", "branch", "supplied"]},
        "changed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "supplied_changes": {"type": "array"},
        "github_context": {"type": ["object", "null"]}
      }
    },
    "change": {"type": ["object", "null"]},
    "impact": {"type": "object"},
    "replacement_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "status", "reason", "remaining_references"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "status": {"enum": ["deleted", "renamed"]},
          "reason": {"type": "string", "minLength": 1},
          "remaining_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "reconciliation": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["planned_paths", "actual_paths", "unplanned_paths", "missing_paths", "evidence_stale", "planned_impact_fingerprint"],
          "properties": {
            "planned_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "actual_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "unplanned_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "missing_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "evidence_stale": {"type": "boolean"},
            "planned_impact_fingerprint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    }
  }
}
