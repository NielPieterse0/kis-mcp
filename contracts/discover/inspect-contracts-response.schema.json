{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis-mcp.local/contracts/discover/inspect-contracts-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "project", "documents", "operations", "schemas", "relationships", "unknowns", "omissions", "confidence", "truncated", "truncation_reasons", "fingerprint"],
  "properties": {
    "schema_version": {"const": 1},
    "tool": {"const": "inspect_contracts"},
    "project": {"$ref": "#/$defs/project"},
    "documents": {"type": "array", "items": {"$ref": "#/$defs/document"}},
    "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
    "schemas": {"type": "array", "items": {"$ref": "#/$defs/schema"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "unknowns": {"type": "array", "items": {"$ref": "#/$defs/unknown"}},
    "omissions": {"$ref": "#/$defs/omissions"},
    "confidence": {"enum": ["high", "medium", "low"]},
    "truncated": {"type": "boolean"},
    "truncation_reasons": {"$ref": "#/$defs/strings"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "nullable_string": {"type": ["string", "null"]},
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "canonical_path", "repository_root", "git_root", "remote_identity"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "canonical_path": {"type": "string", "minLength": 1},
        "repository_root": {"type": "string", "minLength": 1},
        "git_root": {"$ref": "#/$defs/nullable_string"},
        "remote_identity": {"$ref": "#/$defs/nullable_string"}
      }
    },
    "document": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "kind", "version", "title", "provenance"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "kind": {"enum": ["openapi", "json_schema", "mcp_contract"]},
        "version": {"$ref": "#/$defs/nullable_string"},
        "title": {"$ref": "#/$defs/nullable_string"},
        "provenance": {"const": "local_json"}
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "document", "method", "path", "summary", "request_refs", "response_refs", "provenance"],
      "properties": {
        "operation_id": {"type": "string", "minLength": 1},
        "document": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "summary": {"$ref": "#/$defs/nullable_string"},
        "request_refs": {"$ref": "#/$defs/strings"},
        "response_refs": {"$ref": "#/$defs/strings"},
        "provenance": {"const": "openapi_json"}
      }
    },
    "schema": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_id", "document", "name", "schema_type", "required", "property_count", "provenance"],
      "properties": {
        "schema_id": {"type": "string", "minLength": 1},
        "document": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "schema_type": {"$ref": "#/$defs/nullable_string"},
        "required": {"$ref": "#/$defs/strings"},
        "property_count": {"type": "integer", "minimum": 0},
        "provenance": {"enum": ["openapi_json", "json_schema", "mcp_schema_json"]}
      }
    },
    "relationship": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "source", "target", "document", "provenance"],
      "properties": {
        "kind": {"enum": ["ref", "request_schema", "response_schema"]},
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "document": {"type": "string", "minLength": 1},
        "provenance": {"enum": ["openapi_json", "json_schema", "mcp_schema_json"]}
      }
    },
    "unknown": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "reason", "path"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/nullable_string"}
      }
    },
    "omissions": {
      "type": "object", "additionalProperties": false,
      "required": ["documents", "operations", "schemas", "relationships"],
      "properties": {
        "documents": {"type": "integer", "minimum": 0},
        "operations": {"type": "integer", "minimum": 0},
        "schemas": {"type": "integer", "minimum": 0},
        "relationships": {"type": "integer", "minimum": 0}
      }
    }
  }
}
