{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis-mcp.local/contracts/discover/inspect-impact-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "changed_paths", "budget"],
  "properties": {
    "project": {"type": "string", "minLength": 1},
    "changed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "not": {"pattern": "(^|/)\\.\\.(/|$)"}}
    },
    "task_terms": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_symbols", "max_dependants", "max_tests", "max_verifications"],
      "properties": {
        "max_symbols": {"type": "integer", "minimum": 1},
        "max_dependants": {"type": "integer", "minimum": 1},
        "max_tests": {"type": "integer", "minimum": 1},
        "max_verifications": {"type": "integer", "minimum": 1}
      }
    }
  }
}
