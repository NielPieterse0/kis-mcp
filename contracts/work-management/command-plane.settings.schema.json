{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kis-mcp.local/contracts/work-management/command-plane.settings.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "field_authority",
    "work_states",
    "transitions",
    "queue",
    "readiness",
    "transition_requirements",
    "claim",
    "delivery_stages",
    "delivery",
    "completion"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "field_authority": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/authority"}
    },
    "work_states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/state"}
    },
    "transitions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {"$ref": "#/$defs/lifecycleState"}
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_field", "priority_field", "effort_field",
        "created_field", "blocked_by_field", "eligible_states", "priority_order",
        "effort_order", "ranking"
      ],
      "properties": {
        "state_field": {"$ref": "#/$defs/nonEmpty"},
        "priority_field": {"$ref": "#/$defs/nonEmpty"},
        "effort_field": {"$ref": "#/$defs/nonEmpty"},
        "created_field": {"$ref": "#/$defs/nonEmpty"},
        "blocked_by_field": {"$ref": "#/$defs/nonEmpty"},
        "eligible_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/state"}},
        "priority_order": {"$ref": "#/$defs/stringOrder"},
        "effort_order": {"$ref": "#/$defs/stringOrder"},
        "ranking": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["priority", "effort", "created_order", "record_id"]}}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_project_fields", "required_issue_sections", "requires_dependencies_understood"],
      "properties": {
        "required_project_fields": {"$ref": "#/$defs/stringOrder"},
        "required_issue_sections": {"$ref": "#/$defs/stringOrder"},
        "requires_dependencies_understood": {"type": "boolean"}
      }
    },
    "transition_requirements": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/stringOrder"}
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_owner_field", "auto_expiry"],
      "properties": {
        "execution_owner_field": {"$ref": "#/$defs/nonEmpty"},
        "auto_expiry": {"type": "boolean"}
      }
    },
    "delivery_stages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_field", "change_id_field", "complexity_field", "risk_triggers_field", "change_created_stage", "complete_stage"],
      "properties": {
        "stage_field": {"$ref": "#/$defs/nonEmpty"},
        "change_id_field": {"$ref": "#/$defs/nonEmpty"},
        "complexity_field": {"$ref": "#/$defs/nonEmpty"},
        "risk_triggers_field": {"$ref": "#/$defs/nonEmpty"},
        "change_created_stage": {"type": "string", "minLength": 1},
        "complete_stage": {"type": "string", "minLength": 1}
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_state", "require_no_active_claim_after_close"],
      "properties": {
        "terminal_state": {"$ref": "#/$defs/state"},
        "require_no_active_claim_after_close": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "state": {
      "enum": ["inbox", "triage", "proposed", "approved", "ready", "active", "blocked", "on_hold", "deferred", "rejected", "superseded", "done"]
    },
    "lifecycleState": {
      "enum": ["inbox", "triage", "proposed", "approved", "ready", "active", "review", "verification", "documentation", "blocked", "on_hold", "deferred", "rejected", "done", "superseded"]
    },
    "stringOrder": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmpty"}
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "direction"],
      "properties": {
        "authority": {"enum": ["work_management", "work_management_then_repository_change", "repository_change", "git", "github", "actions", "derived"]},
        "direction": {"enum": ["command", "evidence", "handoff"]}
      }
    }
  }
}
